#pragma once

// version.h is generated by CMake from version.h.in; edit the .in file.

#include "avx_optimized/export.h"

/// @file
/// Library version: the version of the headers you compiled against (macros), and of the library
/// you are running with (versionString()).  They differ if a shared library is swapped underneath
/// an existing binary.

#define AVX_OPTIMIZED_VERSION_MAJOR  @PROJECT_VERSION_MAJOR@ ///< Major version of the headers.
#define AVX_OPTIMIZED_VERSION_MINOR  @PROJECT_VERSION_MINOR@ ///< Minor version of the headers.
#define AVX_OPTIMIZED_VERSION_PATCH  @PROJECT_VERSION_PATCH@ ///< Patch version of the headers.
#define AVX_OPTIMIZED_VERSION_STRING "@PROJECT_VERSION@"     ///< Version of the headers, e.g. "0.2.0".

namespace avx_optimized {

/// The version of the library actually loaded at runtime, e.g. "0.2.0".
AVX_OPTIMIZED_EXPORT const char* versionString() noexcept;

} // namespace avx_optimized
